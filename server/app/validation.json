{
	"_comment": "Input rules shared by the backend (app/validation.py) and the frontend (src/lib/validation.ts, imported at build time). Keys: min_length, max_length, pattern. Patterns must work in Python, pydantic and an HTML pattern attribute (JavaScript 'v' flag: escape '-' inside [...]); the backend matches with ^...$ anchors.",
	"setup_token": { "max_length": 128 },
	"invite_token": { "max_length": 128 },
	"role_id": { "max_length": 32 },
	"username": { "min_length": 3, "max_length": 32, "pattern": "^[a-z0-9._\\-]+$" },
	"display_name": { "max_length": 64 },
	"password": { "min_length": 12, "max_length": 256 },
	"totp_secret": { "min_length": 32, "max_length": 32, "pattern": "^[A-Z2-7]+$" },
	"totp_code": { "min_length": 6, "max_length": 6, "pattern": "^[0-9]+$" },
	"sha256": { "min_length": 64, "max_length": 64, "pattern": "^[0-9a-f]+$" },
	"tus_id": { "min_length": 32, "max_length": 32, "pattern": "^[0-9a-f]+$" },
	"original_filename": { "min_length": 1, "max_length": 255, "pattern": "^[^\\/\\\\]+$" },
	"catalog_id": { "min_length": 1, "max_length": 96 },
	"performer_name": { "min_length": 1, "max_length": 64 },
	"tag_value": { "max_length": 64 },
	"tag_id": { "min_length": 1, "max_length": 32, "pattern": "^[a-z0-9_]+$" },
	"tag_value_id": { "min_length": 1, "max_length": 32, "pattern": "^[A-Za-z0-9_\\-]+$" },
	"tag_name": { "min_length": 1, "max_length": 64 },
	"tag_hint": { "min_length": 1, "max_length": 128 },
	"tag_regexp": { "min_length": 1, "max_length": 256 },
	"comment_text": { "min_length": 1, "max_length": 4000 },
	"reference_text": { "min_length": 1, "max_length": 500 },
	"reference_short": { "min_length": 1, "max_length": 64 },
	"reference_name": { "min_length": 1, "max_length": 128 },
	"reference_note": { "min_length": 1, "max_length": 2000 },
	"annotation_target": { "min_length": 2, "max_length": 20000 },
	"annotation_quote": { "min_length": 1, "max_length": 4000 },
	"annotation_note": { "min_length": 1, "max_length": 4000 },
	"search_query": { "min_length": 1, "max_length": 200 },
	"page_text": { "max_length": 100000 },
	"annotation_color": { "min_length": 4, "max_length": 9, "pattern": "^#[0-9A-Fa-f]{3,8}$" },
	"reference_url": { "min_length": 1, "max_length": 2000, "pattern": "^https?://\\S+$" },
	"reference_language": { "min_length": 2, "max_length": 35, "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$" }
}
