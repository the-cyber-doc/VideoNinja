{
	"name": "videoninja-frontend",
	"private": true,
	"version": "0.0.7",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker && openapi-typescript ../server/openapi.json -o src/lib/api/schema.d.ts --check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run test:unit && npm run test:browser",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:browser": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"icons": "node scripts/icons.js",
		"api:types": "openapi-typescript ../server/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"hash-wasm": "^4.12.0",
		"openapi-typescript": "7.13.0",
		"otpauth": "^9.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tus-js-client": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
